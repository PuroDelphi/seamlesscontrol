[Unit]
Description=SeamlessControl Omarchy mesh origin
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
EnvironmentFile=%h/.config/seamlesscontrol/mesh.env
ExecStart=%h/.local/bin/seamlesscontrold mesh ${SEAMLESSCONTROL_PORT}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
