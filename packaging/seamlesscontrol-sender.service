[Unit]
Description=SeamlessControl Omarchy sender
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
EnvironmentFile=%h/.config/seamlesscontrol/sender.env
ExecStart=%h/.local/bin/seamlesscontrold connect ${SEAMLESSCONTROL_PEER} ${SEAMLESSCONTROL_EDGE}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
